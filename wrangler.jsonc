{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "my-blog",
	"main": "src/worker.ts",
	"compatibility_date": "2026-05-07",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "force-trailing-slash",
		"not_found_handling": "404-page"
	},
	"vars": {
		"NODE_VERSION": "22"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
